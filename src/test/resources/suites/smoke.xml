<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke" parallel="methods" thread-count="2">
    <test name="Smoke tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.portfolio.ui"/>
            <package name="com.portfolio.api"/>
        </packages>
    </test>
</suite>